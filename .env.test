# Container Images
APM_SERVER__IMAGE=elastic/apm-server:9.5.7
ELASTIC__IMAGE=elastic/elasticsearch:9.5.7
ENVOY__IMAGE=envoyproxy/envoy:v1.40.2
KAFKA__IMAGE=apache/kafka:4.4.0
KEYCLOAK__IMAGE=keycloak/keycloak:26.8.2
MAILPIT__IMAGE=axllent/mailpit:v1.34.0
MINIO__IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
MYSQL__IMAGE=mysql:8.4.13
OTEL_COLLECTOR__IMAGE=otel/opentelemetry-collector-contrib:0.165.0
POSTGRES__IMAGE=postgres:18.7-alpine
PUSHGATEWAY__IMAGE=prom/pushgateway:v1.11.5
REDIS__IMAGE=redis:8.10.3-alpine
SCYLLADB__IMAGE=scylladb/scylla:2026.3.6
STARROCKS__IMAGE=starrocks/allin1-ubuntu:4.1.8
TEMPORAL__IMAGE=temporalio/temporal:1.10.1
TESTCONTAINERS_RYUK_CONTAINER_IMAGE=testcontainers/ryuk:0.14.0
VAULT__IMAGE=hashicorp/vault:2.2.2

AUTH__SECRET_KEY=test-only-jwt-signing-key-not-a-secret-0123456789
AUTH__TOTP__SECRET_KEY=CHANGE_ME

FILE__SECRET_KEY=CHANGE_ME
FILE__DEFAULT_EXPIRY_MINUTES=10
FILE__ALLOWED_EXTENSIONS=["jpg","png","pdf","txt"]

FASTAPI__PROJECT_NAME="Test API"
FASTAPI__CORS__ALLOW_ORIGINS=["https://example.com"]
FASTAPI__CORS__ALLOW_CREDENTIALS=True
FASTAPI__CORS__ALLOW_METHODS=["GET", "POST"]
FASTAPI__CORS__ALLOW_HEADERS=["Content-Type", "Authorization"]
FASTAPI__CORS__ALLOW_ORIGIN_REGEX=
FASTAPI__CORS__EXPOSE_HEADERS=["X-Total-Count", "X-Request-ID"]
FASTAPI__CORS__MAX_AGE=600
FASTAPI__OPENAPI_URL="/openapi.json"
FASTAPI__DOCS_URL="/docs"
FASTAPI__RE_DOC_URL="/redoc"
FASTAPI__SWAGGER_UI_PARAMS={}

# Temporal Configuration
TEMPORAL__HOST=localhost
TEMPORAL__PORT=7233
TEMPORAL__NAMESPACE=default
TEMPORAL__TASK_QUEUE=test-task-queue
TEMPORAL__ENABLE_METRICS=true

# Redis Configuration
REDIS__MASTER_HOST=localhost:6379
REDIS__DATABASE=0
REDIS__PASSWORD=test_password

# gRPC Rate Limit Configuration
GRPC_RATE_LIMIT__IS_ENABLED=true
GRPC_RATE_LIMIT__FAIL_CLOSED=true
GRPC_RATE_LIMIT__IDENTITY_FROM_ACCESS_TOKEN=true

# PostgreSQL Configuration
POSTGRES_SQLALCHEMY__HOST=localhost
POSTGRES_SQLALCHEMY__PORT=5432
POSTGRES_SQLALCHEMY__DATABASE=test_db
POSTGRES_SQLALCHEMY__USERNAME=test_user
POSTGRES_SQLALCHEMY__PASSWORD=test_password

# MySQL Configuration
MYSQL_SQLALCHEMY__HOST=localhost
MYSQL_SQLALCHEMY__PORT=3306
MYSQL_SQLALCHEMY__DATABASE=test_db
MYSQL_SQLALCHEMY__USERNAME=test_user
MYSQL_SQLALCHEMY__PASSWORD=test_password

# StarRocks Configuration
STARROCKS_SQLALCHEMY__DRIVER_NAME=starrocks
STARROCKS_SQLALCHEMY__HOST=localhost
STARROCKS_SQLALCHEMY__PORT=9030
STARROCKS_SQLALCHEMY__DATABASE=test_db
STARROCKS_SQLALCHEMY__USERNAME=root
STARROCKS_SQLALCHEMY__PASSWORD=

# Keycloak Configuration
KEYCLOAK__SERVER_URL=http://localhost:8080
KEYCLOAK__ADMIN__USERNAME=admin
KEYCLOAK__ADMIN__PASSWORD=admin
KEYCLOAK__REALM_NAME=master
KEYCLOAK__CLIENT_ID=admin-cli
KEYCLOAK__ADMIN__IS_ENABLED=true
KEYCLOAK__ADMIN__REALM_NAME=master
KEYCLOAK__TLS__VERIFY_SSL=false
KEYCLOAK__TIMEOUT=30

# Elasticsearch Configuration
ELASTIC__HOSTS=["http://localhost:9200"]
ELASTIC__AUTH__USER_NAME=elastic
ELASTIC__AUTH__PASSWORD=test_password

# Kafka Configuration
KAFKA__BROKERS_LIST=["localhost:9092"]

# MinIO Configuration
MINIO__ENDPOINT=localhost:9000
MINIO__ACCESS_KEY=test_access_key
MINIO__SECRET_KEY=test_secret_key

# Vault Configuration
VAULT__ENABLED=false
VAULT__AUTH_METHOD=token
VAULT__MOUNT_POINT=secret
VAULT__TLS__VERIFY_SSL=false

# ScyllaDB Configuration
SCYLLADB__CONTACT_POINTS=["localhost"]
SCYLLADB__PORT=9042
SCYLLADB__PROTOCOL_VERSION=4
SCYLLADB__COMPRESSION=true
SCYLLADB__DISABLE_SHARD_AWARENESS=true
SCYLLADB__ADDRESS_TRANSLATION_ENABLED=true

# OpenTelemetry Configuration
OTEL__IS_ENABLED=false
OTEL__TRACES_ENABLED=true
OTEL__METRICS_ENABLED=true
OTEL__LOGS_ENABLED=false
OTEL__LOGS_EXPORTER=console
OTEL__SERVICE_NAME=archipy-test
OTEL__OTLP_ENDPOINT=http://localhost:4317
OTEL__PROTOCOL=grpc
OTEL__OTLP_HEADERS={}
OTEL__TIMEOUT=10.0
OTEL__TRACES_SAMPLE_RATIO=1.0
OTEL__RESOURCE_ATTRIBUTES={}
OTEL__METRIC_EXPORT_INTERVAL_MS=60000
OTEL__METRICS_EXPORTER=otlp
OTEL__METRICS_PULL_HOST=127.0.0.1
OTEL__METRICS_PULL_PORT=8200
OTEL__SYSTEM_METRICS_ENABLED=false
OTEL__ENVIRONMENT=TEST
OTEL__FASTAPI_EXCLUDED_URLS=
OTEL__FASTAPI_OPERATION_SPANS_ENABLED=true
OTEL__LOGS_LEVEL=INFO
